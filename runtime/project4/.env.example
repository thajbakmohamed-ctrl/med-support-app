# PUBLIC TEMPLATE ONLY. Copy to runtime/project4/.env and replace every REPLACE value.
# Never use Project 3 credentials. Never commit the populated .env.
P4_DB_PASSWORD=REPLACE-with-new-random-project4-database-password
P4_JWT_SECRET=REPLACE-with-new-random-project4-jwt-secret-at-least-32-bytes
P4_IDENTITY_SERVICE_KEY=REPLACE-with-new-random-project4-identity-key-at-least-32-characters
P4_NOTIFICATION_SERVICE_KEY=REPLACE-with-new-random-project4-notification-key-at-least-32-characters
# Keep false normally. Bootstrap only after migration and explicit approval.
P4_ADMIN_SEED_ENABLED=false
P4_ADMIN_EMAIL=
P4_ADMIN_PASSWORD=
P4_ADMIN_PHONE=

# Optional Gmail override ONLY; leave blank to continue using Mailpit.
# Supply privately in runtime/project4/.env or the current process environment.
# Full Gmail address and Google App Password (not your Google account password).
# Existing MAIL_USERNAME / MAIL_PASSWORD elsewhere are not loaded or copied.
P4_GMAIL_USERNAME=
P4_GMAIL_APP_PASSWORD=
